#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: op run --env-file=.env -- ./http-test [state-fil]" >&2
  echo "" >&2
  echo "state-fil default: .state.json" >&2
  echo "Krever miljøvariabler ENABLEBANKING_APPLICATION_ID og ENABLEBANKING_PRIVATE_KEY" >&2
  exit 1
}

APP_ID="${ENABLEBANKING_APPLICATION_ID:-}"
PEM="${ENABLEBANKING_PRIVATE_KEY:-}"
STATE_FILE="${1:-.state.json}"
[[ -z "$APP_ID" || -z "$PEM" ]] && usage
[[ ! -f "$STATE_FILE" ]] && { echo "State-fil ikke funnet: $STATE_FILE" >&2; exit 1; }
now=$(date +%s)
exp=$((now+3600))

b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

sjekk_session() {
  apiRequest "/sessions/$SID"
}

hent_transaksjoner() {
  local sessionIndex="$1"
  echo "Velg konto:"
  jq -r '.sessions['$sessionIndex'].accounts | to_entries[] | "[\(.key)] \(.value.details.account_id.other.identification)  \(.value.product)"' < ~/.ynab-enablebanking.json

  read -p "(skriv tallet): " choice

  ACCOUNTID=$(jq -r ".sessions[$sessionIndex].accounts[$choice].uid" < ~/.ynab-enablebanking.json)

  local today=$(date +%Y-%m-%d)
  local weekAgo=$(date -v-7d +%Y-%m-%d)
  apiRequest "/accounts/$ACCOUNTID/transactions?date_from=$weekAgo&date_to=$today"
}

resolve_psu_ip() {
  if [[ -n "${ENABLEBANKING_PSU_IP_ADDRESS:-}" ]]; then
    echo "$ENABLEBANKING_PSU_IP_ADDRESS"
    return
  fi
  local ip
  ip=$(curl -sS --max-time 5 https://ifconfig.me/ip || true)
  if [[ -z "$ip" ]]; then
    echo "Klarte ikke å finne offentlig IP. Sett ENABLEBANKING_PSU_IP_ADDRESS manuelt." >&2
    exit 1
  fi
  echo "$ip"
}

apiRequest() {
  local path="$1"
  local now=$(date +%s)
  local exp=$((now + 3600))

  local h=$(printf '{"typ":"JWT","alg":"RS256","kid":"%s"}' "$APP_ID" | b64url)
  local b=$(printf '{"iss":"enablebanking.com","aud":"api.enablebanking.com","iat":%s,"exp":%s}' "$now" "$exp" | b64url)
  local s=$(printf '%s.%s' "$h" "$b" | openssl dgst -sha256 -sign <(printf '%s' "$PEM") -binary | b64url)
  local jwt="$h.$b.$s"
  local psu_ip
  psu_ip=$(resolve_psu_ip)

  curl -sS \
    -H "Authorization: Bearer $jwt" \
    -H "Accept: application/json" \
    -H "Psu-Ip-Address: $psu_ip" \
    -H "Psu-User-Agent: ${ENABLEBANKING_PSU_USER_AGENT:-ynab-transactions/1.0}" \
    "https://api.enablebanking.com$path" | jq
}

echo "Velg Session IDs:"
jq -r '.sessions | to_entries[] | "[\(.key)] \(.value.sessionId) - \(.value.aspspName)"' < ~/.ynab-enablebanking.json

read -p "(skriv tallet): " choice

SID=$(jq -r ".sessions[$choice].sessionId" < ~/.ynab-enablebanking.json)

read -p "Hva vil du gjøre?
[0] Sjekke session
[1] Hente transaksjoner
Velg: " action

case $action in
  0) sjekk_session ;;
  1) hent_transaksjoner $choice;;
  *) echo "Ugyldig valg" ;;
esac